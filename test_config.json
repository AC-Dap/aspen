{
  "LastUpdated": 100,
  "Middleware": {
    "logger": { "Disabled": false, "Params": {} },
    "auth": { "Disabled": false, "Params": { "Path": "/auth" } }
  },
  "Routes": [
    {
      "Route": "/auth",
      "Id": "auth",
      "Resource": {
        "Type": "auth",
        "Params": {
          "LoginPage": "pages/auth/login.html"
        }
      }
    },
    {
      "Route": "/info",
      "Id": "info",
      "Resource": {
        "Type": "static_file",
        "Params": { "Filepath": "README.md" }
      }
    },
    {
      "Route": "/design",
      "Id": "design",
      "Resource": {
        "Type": "static_file",
        "Params": { "Filepath": "design.md" }
      }
    },
    {
      "Route": "/code",
      "Id": "resources",
      "AccessRoles": ["admin"],
      "Resource": {
        "Type": "directory",
        "Params": {
          "AllowDirectoryBrowsing": true,
          "Path": "services/test",
          "Whitelist": ["*"]
        }
      }
    },
    {
      "Route": "/test/*path",
      "Id": "test-resource",
      "Resource": {
        "Type": "proxy",
        "Params": {
          "Host": "http://localhost",
          "Methods": ["GET"],
          "Path": "/*path"
        }
      }
    },
    {
      "Route": "/api",
      "Id": "api",
      "Resource": { "Type": "api", "Params": {} }
    },
    {
      "Route": "/tak/*path",
      "Id": "tak",
      "Resource": {
        "Type": "proxy",
        "Params": {
          "Host": "http://localhost:3000",
          "Methods": ["GET"],
          "Path": "/tak/*path"
        }
      }
    }
  ],
  "Services": []
}
